PORT=5000
MONGO_URI=mongodb://localhost:27017/hometown_hub
JWT_SECRET=change_this_to_a_long_random_secret
NODE_ENV=development
# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN=https://hometown-hub.vercel.app
CORS_ORIGIN=
# Public URL of this backend, used to build image URLs returned by uploads.
# Leave blank locally (falls back to the request's own host). Set this in
# production, e.g. PUBLIC_BASE_URL=https://hometown-hub-api.onrender.com
PUBLIC_BASE_URL=
